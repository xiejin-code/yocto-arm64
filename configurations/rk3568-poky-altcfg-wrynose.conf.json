            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "6bf0d8ad57b33950bab4c7f6c037e1ccb6f6e2eb"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "824795b885b25e074a2880fbcd54e1a6c875d47d"
            }
        },
        "meta-arm": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-arm",
                "branch": "wrynose",
                "rev": "caa36c53f796beb25d9b9f58b1b7a492e9987e15"
            }
        },
        "meta-rockchip": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-rockchip",
                "branch": "wrynose",
                "rev": "9d02575bfd9ca5e87c394f593f2bbdbdee914d4e"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "rk3568",
                "description": "RK3568 platform with the Poky systemd distribution",
                "setup-dir-name": "rk3568-wrynose",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-rockchip",
                    "meta-openembedded/meta-oe"
                ],
                "bb-layers-file-relative": [
                    "../meta-fzhub"
                ],
                "oe-fragments": [
                    "machine/fzhub",
                    "distro/poky-altcfg",
                    "fzhub/build-defaults"
                ]
            }
        ]
    },
    "version": "1.0"
}
